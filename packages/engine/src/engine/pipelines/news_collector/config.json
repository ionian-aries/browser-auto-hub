  {
    "source_name": "新华社",
    "base_url": "https://www.news.cn",
    "configs": {
      "list": {
        "mode": "script",
        "fields": {
          "items": "const items = document.querySelectorAll('ul.xhwp_list li'); return Array.from(items).map(li => { const a = li.querySelector('a'); if (!a) return null; const href = a.getAttribute('href') || ''; const title = a.innerText?.trim(); const m = href.match(/\\/(\\d{8})\\//); const date = m ? `${m[1].slice(0,4)}-${m[1].slice(4,6)}-${m[1].slice(6,8)}` : null; return { title, date, url: href }; }).filter(i => i && i.title);"
        }
      },
      "pagination": null,
      "detail": {
        "mode": "selectors",
        "fields": {
          "title": "h1#detailContent",
          "date": "span.article-time",
          "content": "div#detailContent",
          "source": "span.article-source"
        }
      }
    },
    "entries": [
      {
        "entry_name": "时政",
        "url": "https://www.news.cn/politics/index.html"
      },
      {
        "entry_name": "国际",
        "url": "https://www.news.cn/world/index.html"
      },
      {
        "entry_name": "财经",
        "url": "https://www.news.cn/fortune/index.htm"
      }
    ]
  },
