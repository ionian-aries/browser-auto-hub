# ============================================================
# Browser Auto Hub - 环境变量配置
# 复制此文件为 .env 并填写实际值
# ============================================================

# === 数据库 ===
# 应用连接用（唯一必填），格式与 himea-agent-infra 一致
DATABASE_URL=mysql+aiomysql://root:changeme@127.0.0.1:3306/browser_auto_hub?charset=utf8mb4

# Docker 容器初始化用（仅 docker compose up 自建 MySQL 时需要）
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=browser_auto_hub

# === MinIO 对象存储 ===
# 参考: browser-agent/oa-communicate-todos/config.json
MINIO_ENDPOINT=http://minio:9000         # 完整URL；本地开发改为 http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=browser-auto-hub
MINIO_OBJECT_PREFIX=browser-auto-hub
MINIO_PRESIGN_EXPIRES_SECONDS=604800      # 预签名URL过期时间（秒），默认7天

# === 应用配置 ===
APP_SECRET_KEY=changeme                   # 用于签名/加密的随机密钥
APP_LOG_LEVEL=INFO                        # DEBUG / INFO / WARNING / ERROR

# === 端口映射（仅 Docker Compose 使用） ===
BACKEND_PORT=8900
FRONTEND_PORT=3200
MYSQL_PORT=3306
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
