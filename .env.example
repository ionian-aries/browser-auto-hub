# Browser Auto Hub — 环境变量模板
# 复制为 .env 并填写实际值。库表与 MinIO bucket 需提前创建，应用仅连接。

# 数据库连接串
DATABASE_URL=mysql+aiomysql://root:changeme@127.0.0.1:3306/browser_auto_hub?charset=utf8mb4

# MinIO 对象存储（pipeline 业务附件）
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=browser-auto-hub
MINIO_OBJECT_PREFIX=attachments

# 平台对外地址：pipeline 拼接附件下载 URL（/api/files/{key}，spec 1 二十三次修订）
# 部署时改为消费方实际可达的地址:端口
PUBLIC_BASE_URL=http://127.0.0.1:8900

# 服务端口（docker-compose 端口映射，可选覆盖）
BACKEND_PORT=8900
FRONTEND_PORT=3200
