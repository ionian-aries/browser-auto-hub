FROM node:18-alpine AS builder
# corepack 在 Node 18 上拉取新版 pnpm 触发 ERR_VM_DYNAMIC_IMPORT_CALLBACK_MISSING，
# 改为显式安装 pnpm@9（与 lockfileVersion 9.0 对齐）
RUN npm install -g pnpm@9
WORKDIR /app
# 锁文件在 pnpm workspace 根（非 packages/frontend 内），按 workspace 结构复制后
# --filter 安装，保证 --frozen-lockfile 真正生效（spec 1 二十一次修订）
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/frontend/package.json packages/frontend/
RUN pnpm install --frozen-lockfile --filter frontend...
COPY packages/frontend/ packages/frontend/
RUN pnpm --filter frontend build

FROM nginx:alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/packages/frontend/dist /usr/share/nginx/html
EXPOSE 80
