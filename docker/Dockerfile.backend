FROM python:3.11-slim

RUN apt-get update && apt-get install -y \
    wget gnupg2 \
    libnss3 libatk-bridge2.0-0 libdrm2 libxcomposite1 \
    libxdamage1 libxrandr2 libgbm1 libasound2 libpangocairo-1.0-0 \
    libgtk-3-0 fonts-wqy-zenhei \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js for playwright-cli
RUN apt-get update && apt-get install -y curl && \
    curl -fsSL https://deb.nodesource.com/setup_18.x | bash - && \
    apt-get install -y nodejs && \
    npm install -g @playwright/cli && \
    rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY packages/backend/pyproject.toml packages/backend/
COPY packages/engine/pyproject.toml packages/engine/
# 两段式：源码未 COPY 时成员包（hatchling src 布局）无法构建，先只装第三方依赖；
# --all-packages 必带——根 project 无 dependencies，不加则环境为空
RUN uv sync --frozen --no-dev --all-packages --no-install-workspace

# Install Playwright Chromium browser binary
RUN uv run playwright install chromium

COPY packages/backend/src/ packages/backend/src/
COPY packages/engine/src/ packages/engine/src/
# 装入 workspace 成员包（依赖已缓存，秒级）
RUN uv sync --frozen --no-dev --all-packages

EXPOSE 8900

CMD ["uv", "run", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8900"]
